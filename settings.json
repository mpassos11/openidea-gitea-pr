{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Gitea Pull Requests",
  "properties": {
    "baseUrl": {
      "type": "string",
      "title": "Gitea API base URL",
      "description": "e.g. https://gitea.example.com/api/v1"
    },
    "owner": { "type": "string", "title": "Repository owner" },
    "repo": { "type": "string", "title": "Repository name" },
    "defaultBranch": { "type": "string", "title": "Default base branch", "default": "main" }
  },
  "required": ["baseUrl", "owner", "repo"]
}
